# Frontend env (copy to .env)

# Optional for local dev — lib/api.ts falls back to http://localhost:4000/api when
# unset, which matches the backend's own local default (backend/.env.example's PORT).
#
# Required at build time in production: Vite bakes VITE_* variables into the JS
# bundle when you run `vite build`, not at runtime. If the frontend and backend are
# deployed to separate domains, an unset value here means every deployed user's
# browser will try to call localhost — their own machine, not your backend — and
# every API request will fail. Set this as a build-time environment variable in your
# hosting platform's dashboard (Vercel/Netlify project settings), not by committing a
# real .env file with the production URL into git.
VITE_API_BASE_URL=http://localhost:4000/api
