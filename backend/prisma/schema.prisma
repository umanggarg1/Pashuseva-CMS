generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Phase 32: native partial unique index for "at most one WhatsApp number per
  // customer" (CustomerPhone below). Verified in PHASE32_TODO.md A0 against Prisma
  // 7.9.1: generates exactly `CREATE UNIQUE INDEX … WHERE ("isWhatsapp" = true)` and
  // changes nothing in the existing schema.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
}

// Per-module list/record visibility for a Manager or Employee — Admin is always
// "All", hardcoded in code, never stored (Phase 15 addendum). Null means "use the
// pre-addendum default" (Manager: their team, Employee: their own), so every
// existing account keeps its exact current behavior with no backfill needed.
enum DataScope {
  ALL
  ASSIGNED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// Phase 17: Order Status now mostly follows Delivery Status automatically
// (orderService.updateDeliveryStatus's sync) — Completed was replaced by
// Out for Delivery/Delivered so the two lists mirror each other for the normal
// progression. Manual PATCH /orders/:id/status only allows Pending/Confirmed/
// Processing (pre-dispatch workflow); Out for Delivery/Delivered/Cancelled are
// reachable only via delivery-status sync or the dedicated cancel endpoint.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

// Phase 17: two branches after dispatch — the normal forward path (through
// Delivered), and the return/exception path once an already-dispatched order is
// cancelled (Return Pending → Return In Transit → Returned). Lost/Damaged are
// exception states reachable from any in-transit point, not part of either
// sequence. See orderService's DELIVERY_TO_ORDER_STATUS for how these drive
// Order Status automatically.
enum DeliveryStatus {
  NOT_DISPATCHED
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURN_PENDING
  RETURN_IN_TRANSIT
  RETURNED
  LOST
  DAMAGED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER
}

enum WeightUnit {
  G
  KG
  ML
  L
}

enum PackagingUnit {
  PIECE
  PACKET
  BOX
  BAG
  BOTTLE
}

// ── Phase 32: WhatsApp automation (see PHASE32_TODO.md §5) ─────────────────────

// Per-customer WhatsApp message language. Only picks which approved Meta template
// is used — names, products, units, numbers are never translated (§4.3).
enum MessageLanguage {
  EN
  HI
}

// Staff-recorded consent: YES – Customer agreed / NO – Customer declined. The only
// consent control (frozen decision, §6) — no separate opt-out flag anywhere.
enum WhatsappConsent {
  YES
  NO
}

// Who/what last set Customer.whatsappConsent.
enum ConsentSource {
  STAFF
  CUSTOMER_STOP_REPLY
  BACKFILL
}

enum MessageChannel {
  WHATSAPP
}

enum MessageType {
  ORDER_CONFIRMATION
  ORDER_DISPATCHED
}

// §5/§9. PROCESSING and RETRY_WAIT are operational; SENT < DELIVERED < READ are
// provider-confirmed progress; UNKNOWN = Meta may have accepted it and is never
// retried automatically.
enum MessageStatus {
  QUEUED
  PROCESSING
  RETRY_WAIT
  SENT
  DELIVERED
  READ
  FAILED
  UNKNOWN
  SKIPPED
}

enum MessageErrorKind {
  TEMPORARY
  PERMANENT
  CONFIGURATION
  AMBIGUOUS
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  name         String?
  // Required at public signup, not required for an Admin/Manager-created account
  // (enforced in the zod schemas, not here) — existing rows predate this field.
  phone        String?
  // Null until an Admin approves the account (Phase 15) — a self-signed-up user has
  // no role and no access until then. Still non-null for every Admin/Manager-created
  // account, which stays a one-step "create with a role" flow, not signup+approval.
  role         Role?
  // A signup-time hint only ("I'm applying as...") — never authoritative. The Admin
  // picks the real `role` at approval time, independently of this value.
  requestedRole Role?
  status       AccountStatus @default(ACTIVE)
  // Per-module Data Scope (Phase 15 addendum) — Products has no equivalent field,
  // since products aren't per-employee. Null = pre-addendum default, see DataScope.
  customerDataScope DataScope?
  orderDataScope    DataScope?
  // Phase 18: replaced the single managerId FK — an Employee can now report to
  // several Managers at once. A customer/order auto-created by such an Employee
  // (with no manager explicitly chosen) becomes visible to all of them, not just
  // one — see utils/dataScope.ts and EmployeeManager below.
  managedBy    EmployeeManager[] @relation("EmployeeManagerEmployee")
  managing     EmployeeManager[] @relation("EmployeeManagerManager")
  // Who approved/rejected this account, and when — set once, at that decision.
  reviewedBy   User?         @relation("UserReviewedBy", fields: [reviewedById], references: [id])
  reviewedById Int?
  reviewedAt   DateTime?
  reviewedUsers User[]       @relation("UserReviewedBy")
  // Who suspended this account, and when — cleared back to null on reactivation, so
  // this always reflects the current suspension (if any), not a full history.
  suspendedBy   User?        @relation("UserSuspendedBy", fields: [suspendedById], references: [id])
  suspendedById Int?
  suspendedAt   DateTime?
  suspendedUsers User[]      @relation("UserSuspendedBy")
  // Trash (Phase 3 addendum) — an Employee/Manager moved to Trash by Admin.
  // deletedAt set = hidden from every normal list; purgedAt set = permanently
  // anonymized, no longer restorable, no longer shown in Trash either.
  deletedBy    User?         @relation("UserDeletedBy", fields: [deletedById], references: [id])
  deletedById  Int?
  deletedAt    DateTime?
  deletionExpiresAt DateTime?
  purgedAt     DateTime?
  deletedUsers User[]        @relation("UserDeletedBy")
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customerDeletions             Customer[]          @relation("CustomerDeletedBy")
  orderDeletions                 Order[]            @relation("OrderDeletedBy")
  productDeletions                Product[]         @relation("ProductDeletedBy")
  activities                   CustomerActivity[]
  auditLogs                    AuditLog[]
  customerNotes                CustomerNote[]
  notifications                Notification[]
  DeliveryTrackingUpdated      DeliveryTracking[]   @relation("DeliveryUpdatedBy")
  permissions                  UserPermission[]     @relation("UserPermissions")
  grantedPermissions           UserPermission[]     @relation("PermissionGrantedBy")
  passwordResetTokens          PasswordResetToken[]
  assignedCustomersAsEmployee  CustomerAssignedEmployee[] @relation("CustomerAssignedEmployees")
  assignedCustomersAsManager   Customer[]           @relation("CustomerAssignedManager")
  createdCustomers             Customer[]           @relation("CustomerCreatedBy")
  createdProducts               Product[]           @relation("ProductCreatedBy")
  productActivities             ProductActivity[]
  createdOrders                 Order[]             @relation("OrderCreatedBy")
  assignedOrders                OrderAssignedEmployee[] @relation("OrderAssignedEmployees")
  cancelledOrders                Order[]            @relation("OrderCancelledBy")
  orderActivities                OrderActivity[]
  orderNotes                     OrderNote[]
  stockHistoryEntries             StockHistory[]     @relation("StockHistoryCreatedBy")
  paymentsCreated                 Payment[]          @relation("PaymentCreatedBy")
  // Phase 32
  whatsappConsentsRecorded    Customer[]                 @relation("CustomerWhatsappConsentBy")
  outboundMessagesTriggered   OutboundMessage[]          @relation("OutboundMessageTriggeredBy")
  outboundMessagesResolved    OutboundMessage[]          @relation("OutboundMessageResolvedBy")
}

// Phase 18: several managers can share an Employee (all see/manage that team
// member), replacing the old single User.managerId. No extra metadata beyond
// who/when — same pattern as OrderAssignedEmployee/UserPermission.
model EmployeeManager {
  id         Int      @id @default(autoincrement())
  employee   User     @relation("EmployeeManagerEmployee", fields: [employeeId], references: [id])
  employeeId Int
  manager    User     @relation("EmployeeManagerManager", fields: [managerId], references: [id])
  managerId  Int
  createdAt  DateTime @default(now())

  @@unique([employeeId, managerId])
  @@index([employeeId])
  @@index([managerId])
}

model UserPermission {
  id          Int      @id @default(autoincrement())
  user        User     @relation("UserPermissions", fields: [userId], references: [id])
  userId      Int
  permission  String
  grantedBy   User?    @relation("PermissionGrantedBy", fields: [grantedById], references: [id])
  grantedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, permission])
  @@index([userId])
  @@index([grantedById])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Customer {
  id                 Int               @id @default(autoincrement())
  name               String
  email              String?
  notes              String?
  // Phase 19: fully derived from order history now (see
  // utils/customerAutomation.ts's recalculateCustomerState) — a brand-new customer
  // with no orders yet defaults to Inactive, same as the derived rule would compute.
  status             CustomerStatus    @default(INACTIVE)
  phones             CustomerPhone[]
  addresses          CustomerAddress[]
  orders             Order[]
  customerNotes      CustomerNote[]
  activities         CustomerActivity[]
  // Phase 19: replaced the single assignedEmployeeId FK — several employees can now
  // share a customer (e.g. one per order they've each created for that customer),
  // not just one. See CustomerAssignedEmployee below and utils/dataScope.ts.
  assignedEmployees  CustomerAssignedEmployee[]
  assignedManager    User?             @relation("CustomerAssignedManager", fields: [assignedManagerId], references: [id])
  assignedManagerId  Int?
  createdBy          User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdById        Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  // Trash (Phase 3 addendum). deletedAt set = hidden from every normal list, but
  // Orders referencing this customer are untouched — see phases.md's addendum for
  // why. purgedAt set = permanently anonymized (name/email/phones/addresses
  // scrubbed), no longer restorable — a real `DELETE FROM` isn't possible here,
  // every order ever placed blocks it at the database level.
  deletedBy          User?             @relation("CustomerDeletedBy", fields: [deletedById], references: [id])
  deletedById        Int?
  deletedAt          DateTime?
  deletionExpiresAt  DateTime?
  purgedAt           DateTime?
  // Phase 32 (§6). Column default NO is the safe default for any row written
  // without a value; the API requires an explicit value on create (form preselects
  // YES), and existing customers are set to YES by the one-time audited backfill
  // (A5, source BACKFILL) — not by this migration.
  preferredLanguage     MessageLanguage            @default(EN)
  whatsappConsent       WhatsappConsent            @default(NO)
  whatsappConsentAt     DateTime?
  // Staff member who last set it; null when set by a STOP reply or the backfill.
  whatsappConsentBy     User?                      @relation("CustomerWhatsappConsentBy", fields: [whatsappConsentById], references: [id])
  whatsappConsentById   Int?
  whatsappConsentSource ConsentSource?
  outboundMessages      OutboundMessage[]

  @@index([assignedManagerId])
  @@index([createdById])
  @@index([deletedAt])
  @@index([whatsappConsentById])
}

// Phase 19: several employees can share a customer (all see it, one row per
// employee who's worked an order for them), replacing the old single
// Customer.assignedEmployeeId. No extra metadata beyond who/when — same pattern as
// OrderAssignedEmployee/EmployeeManager.
model CustomerAssignedEmployee {
  id         Int      @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  employee   User     @relation("CustomerAssignedEmployees", fields: [employeeId], references: [id])
  employeeId Int
  assignedAt DateTime @default(now())

  @@unique([customerId, employeeId])
  @@index([customerId])
  @@index([employeeId])
}

model CustomerPhone {
  id         Int     @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  phone      String
  label      String?
  isPrimary  Boolean @default(false)
  // Phase 32: the number order/dispatch WhatsApp messages go to. Independent of
  // isPrimary (one row can be both). At most one per customer, enforced by the
  // database (partial unique index below), not only by validation.
  isWhatsapp Boolean  @default(false)

  @@unique([customerId], map: "CustomerPhone_one_whatsapp_per_customer", where: { isWhatsapp: true })
  @@index([customerId])
}

model CustomerAddress {
  id         Int     @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  line1      String
  line2      String?
  city       String
  district   String?
  state      String
  pincode    String
  landmark   String?
  country    String   @default("India")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model ProductCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  categoryId    Int?
  sku           String   @unique
  price         Float
  // Net weight/quantity, separate from `unit` (packaging type) below — e.g.
  // weightValue=1, weightUnit=KG for a 1kg bag. Both optional and always set
  // together (enforced in the zod schemas, not here): not every product has a
  // meaningful net weight.
  weightValue   Float?
  weightUnit    WeightUnit?
  // Packaging type (Piece/Packet/Box/Bag/Bottle) — was free text, now a fixed
  // dropdown for consistent reporting/filtering.
  unit          PackagingUnit?
  availableQty  Int      @default(0)
  minimumStock  Int      @default(0)
  image         String?
  active        Boolean  @default(true)
  createdBy     User?    @relation("ProductCreatedBy", fields: [createdById], references: [id])
  createdById   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orderItems    OrderItem[]
  activities    ProductActivity[]
  stockHistory  StockHistory[]
  // Trash (Phase 3 addendum). No `purgedAt` here — Product is the one entity where
  // Permanent Delete is a real `DELETE FROM` (OrderItem.productId is already
  // ON DELETE SET NULL, and productName/productSKU/unitPrice are already snapshotted
  // there independently, so nothing historical breaks). Once purged the row is
  // simply gone, not marked.
  deletedBy         User?      @relation("ProductDeletedBy", fields: [deletedById], references: [id])
  deletedById       Int?
  deletedAt         DateTime?
  deletionExpiresAt DateTime?

  @@index([categoryId])
  @@index([createdById])
  @@index([deletedAt])
}

model StockHistory {
  id          Int      @id @default(autoincrement())
  product     Product  @relation(fields: [productId], references: [id])
  productId   Int
  change      Int
  reason      String
  note        String?
  order       Order?   @relation(fields: [orderId], references: [id])
  orderId     Int?
  createdBy   User?    @relation("StockHistoryCreatedBy", fields: [createdById], references: [id])
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([orderId])
}

// Append-only payment ledger (Phase 13) — same shape/philosophy as StockHistory and
// DeliveryTracking: never mutated or deleted after creation. A mistaken payment is
// corrected by adding a negative row that references the original via
// reversesPaymentId, not by editing or deleting the original — Order.paymentStatus is
// always derived from SUM(amount) over this table, never set directly.
model Payment {
  id                Int           @id @default(autoincrement())
  order             Order         @relation(fields: [orderId], references: [id])
  orderId           Int
  amount            Float
  method            PaymentMethod
  referenceNumber   String?
  paymentDate       DateTime      @default(now())
  notes             String?
  reversesPayment   Payment?      @relation("PaymentReversal", fields: [reversesPaymentId], references: [id])
  reversesPaymentId Int?
  reversedBy        Payment[]     @relation("PaymentReversal")
  createdBy         User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdById       Int?
  createdAt         DateTime      @default(now())

  @@index([orderId])
  @@index([createdById])
}

model ProductActivity {
  id          Int      @id @default(autoincrement())
  product     Product  @relation(fields: [productId], references: [id])
  productId   Int
  activity    String
  metadata    Json?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([createdById])
}

model Order {
  id                  Int            @id @default(autoincrement())
  orderNumber         String         @unique
  customer            Customer       @relation(fields: [customerId], references: [id])
  customerId          Int
  orderDate           DateTime       @default(now())
  subtotal            Float
  discount             Float         @default(0)
  shipping             Float         @default(0)
  total               Float
  paymentMethod       PaymentMethod
  // Computed, not directly settable via API — written by orderService whenever a
  // Payment is added/reversed (SUM(payments.amount) vs. total), replacing the old
  // bare manual dropdown from Phase 6 (Phase 13). Kept as a real column, not derived
  // on every read, so list/filter queries stay fast — same tradeoff already made for
  // every other status field on this model.
  paymentStatus       PaymentStatus  @default(PENDING)
  // Generated alongside orderNumber at creation (Phase 13) — every order always has
  // one, no "not yet generated" state to handle anywhere.
  invoiceNumber       String?        @unique
  orderStatus         OrderStatus    @default(PENDING)
  deliveryStatus      DeliveryStatus @default(NOT_DISPATCHED)
  // Renamed from the unused `trackingNumber` (was never wired up anywhere since
  // Phase 6) rather than adding a new column — same concept, courier-provided
  // reference number, just a name that matches what the UI/API actually call it.
  articleNumber       String?
  courier             String?
  // Informational only — deliberately NOT part of subtotal/discount/shipping/total.
  // Float, matching every other money field on this model (subtotal/discount/
  // shipping/total) — introducing Decimal for just this one field would mean
  // different serialization/type handling for a single sibling field with no
  // practical benefit at this app's scale.
  estimatedDeliveryCharges Float?
  expectedDelivery    DateTime?
  deliveredDate       DateTime?
  notes               String?
  createdBy           User?    @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdById         Int?
  // Phase 18: replaced the single assignedEmployeeId FK — several employees can now
  // share visibility/work on one order, not just be informed about it. See
  // OrderAssignedEmployee below and utils/dataScope.ts's hasOrderDataAccess.
  assignedEmployees   OrderAssignedEmployee[]
  cancelledBy         User?    @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  cancelledById       Int?
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  items               OrderItem[]
  address             OrderAddress?
  activities          OrderActivity[]
  orderNotes          OrderNote[]
  tracking            DeliveryTracking[]
  stockHistory        StockHistory[]
  payments            Payment[]
  // Trash (Phase 3 addendum). purgedAt set = permanently removed from Trash view;
  // unlike Customer, nothing is scrubbed on purge — an Order is a financial/business
  // record (it has its own Payment ledger), not personal data, so there's nothing
  // here that needs anonymizing the way Customer's contact details do.
  deletedBy           User?             @relation("OrderDeletedBy", fields: [deletedById], references: [id])
  deletedById         Int?
  deletedAt           DateTime?
  deletionExpiresAt   DateTime?
  purgedAt            DateTime?
  // Phase 32 (§8, §19.2): client-supplied Idempotency-Key for POST /orders and
  // reorder, plus a hash of (acting user + request body) so a reused key with
  // different order details is rejected instead of returning the wrong order.
  // Null for every pre-Phase-32 order (Postgres allows many NULLs under UNIQUE).
  idempotencyKey           String?                 @unique
  idempotencyHash          String?
  outboundMessages         OutboundMessage[]

  @@index([customerId])
  @@index([createdById])
  @@index([cancelledById])
  @@index([deletedAt])
  // Phase 14 §15: every Orders-list filter, every Dashboard groupBy, and every
  // Report's date-range query filters or sorts on one of these four — none of them
  // had an index before this.
  @@index([orderStatus])
  @@index([deliveryStatus])
  @@index([paymentStatus])
  @@index([orderDate])
}

// Phase 18: several employees can share an order (all see it, all can work it),
// replacing the old single Order.assignedEmployeeId. No extra metadata beyond who/
// when — same pattern as UserPermission.
model OrderAssignedEmployee {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    Int
  employee   User     @relation("OrderAssignedEmployees", fields: [employeeId], references: [id])
  employeeId Int
  assignedAt DateTime @default(now())

  @@unique([orderId, employeeId])
  @@index([orderId])
  @@index([employeeId])
}

model OrderItem {
  id         Int    @id @default(autoincrement())
  order      Order  @relation(fields: [orderId], references: [id])
  orderId    Int
  product    Product? @relation(fields: [productId], references: [id])
  productId  Int?
  productName String
  productSKU  String
  unit       String?
  quantity   Int
  unitPrice  Float
  discount   Float  @default(0)
  totalPrice Float

  @@index([orderId])
  @@index([productId])
}

model OrderAddress {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     Int      @unique
  addressLine String
  landmark    String?
  city        String
  district    String?
  state       String
  pincode     String
  country     String   @default("India")
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model OrderActivity {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     Int
  action      String
  oldValue    String?
  newValue    String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([createdById])
}

model OrderNote {
  id          Int      @id @default(autoincrement())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     Int
  note        String
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([createdById])
}

model DeliveryTracking {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    Int
  status     String
  note       String?
  location   String?
  receivedBy String?
  updatedBy  User?    @relation("DeliveryUpdatedBy", fields: [updatedById], references: [id])
  updatedById Int?
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([updatedById])
}

model CustomerNote {
  id         Int      @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  note       String
  createdBy  User?    @relation(fields: [createdById], references: [id])
  createdById Int?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([createdById])
}

model CustomerActivity {
  id         Int      @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  activity   String
  metadata   Json?
  createdBy  User?    @relation(fields: [createdById], references: [id])
  createdById Int?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([createdById])
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Phase 32: WhatsApp automation (PHASE32_TODO.md §5, §9, §12, §19) ───────────

// One row per WhatsApp message (an outbox / queue row). Created inside the same
// transaction as the event that causes it (order created / dispatch transition /
// manual resend), sent afterwards by the dispatcher. `eventKey` is unique, so one
// logical event can never produce a second message.
model OutboundMessage {
  id           Int               @id @default(autoincrement())
  // ORDER_CREATED:<orderId> / ORDER_DISPATCHED:<orderId> / RESEND:<uuid> (§7)
  eventKey     String            @unique
  channel      MessageChannel    @default(WHATSAPP)
  type         MessageType
  order        Order?            @relation(fields: [orderId], references: [id])
  orderId      Int?
  customer     Customer          @relation(fields: [customerId], references: [id])
  customerId   Int
  // A manual resend points at the message it re-sends (§13).
  resendOf     OutboundMessage?  @relation("OutboundMessageResend", fields: [resendOfId], references: [id])
  resendOfId   Int?
  resends      OutboundMessage[] @relation("OutboundMessageResend")
  resendReason String?
  // Idempotency-Key of the Resend API request.
  requestKey   String?           @unique

  // Snapshot taken at enqueue — retries send exactly this, never rebuilt.
  toPhone              String? // normalized 91XXXXXXXXXX
  // Plain Int on purpose — NO foreign key: CustomerPhone rows are deleted when a
  // number is edited, and an FK would block that. The pre-send check re-verifies
  // the row still exists / belongs to the customer / is still the WhatsApp number.
  toPhoneId            Int?
  language             MessageLanguage
  fallbackFromLanguage MessageLanguage?
  templateName         String?
  params               Json?
  snapshot             Json?

  status     MessageStatus     @default(QUEUED)
  skipReason String?
  errorKind  MessageErrorKind?
  errorCode  String?
  lastError  String?

  // Queue / worker bookkeeping (§9, §19.3)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  nextAttemptAt DateTime  @default(now())
  expiresAt     DateTime
  lockedAt      DateTime?
  lockedUntil   DateTime?
  lockedBy      String?
  // New uuid on every claim; every later worker write must match it.
  claimToken    String?
  // Committed right before the Meta call: set → Meta may have been called (a lost
  // lease becomes UNKNOWN); null → safe to re-queue.
  sendStartedAt DateTime?
  lastAttemptAt DateTime?

  // Provider progress
  providerMessageId String?   @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?

  triggeredBy      User?    @relation("OutboundMessageTriggeredBy", fields: [triggeredById], references: [id])
  triggeredById    Int?
  // Admin who resolved an UNKNOWN (mark sent / mark failed and resend).
  resolvedBy       User?    @relation("OutboundMessageResolvedBy", fields: [resolvedById], references: [id])
  resolvedById     Int?
  // A Meta answer that arrived after the worker lost its claim (§19.3).
  lateResponseNote String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  statusEvents MessageStatusEvent[]

  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@index([orderId, type])
  @@index([customerId])
  @@index([resendOfId])
  @@index([triggeredById])
  @@index([resolvedById])
}

// Webhook status history from Meta + duplicate protection: the unique pair makes a
// repeated webhook a no-op (§12). messageId is null when the wamid matched nothing.
model MessageStatusEvent {
  id                Int              @id @default(autoincrement())
  providerMessageId String
  status            String // sent / delivered / read / failed (as Meta sends it)
  providerTimestamp DateTime
  errorCode         String?
  raw               Json
  message           OutboundMessage? @relation(fields: [messageId], references: [id])
  messageId         Int?
  createdAt         DateTime         @default(now())

  @@unique([providerMessageId, status])
  @@index([messageId])
}

// Single row (id = 1), created on first use. Global messaging switches that every
// worker instance must agree on.
model MessagingState {
  id               Int       @id
  // Circuit breaker (§11): set atomically by the first CONFIGURATION error.
  pausedAt         DateTime?
  pauseReason      String?
  pausedBy         String? // "system" or a user id
  // Shared back-off after a Meta 429 (§19.4).
  rateLimitedUntil DateTime?
  // Q16 / §7.1: set ONCE, the first time WhatsApp is enabled in production; orders
  // created before it never get a WhatsApp message. Never moved afterwards.
  goLiveAt         DateTime?
  updatedAt        DateTime  @updatedAt
}

// Cached Meta template approval status per name + language (§4.4). Meta's own
// error at send time always wins over this cache.
model MessageTemplateStatus {
  name      String
  language  String
  status    String // APPROVED / PENDING / REJECTED / PAUSED / DISABLED
  checkedAt DateTime

  @@id([name, language])
}
