# Backend env (copy to .env)
DATABASE_URL=postgresql://user:password@localhost:5432/crm_db
# Optional: direct (non-pooled) connection used only by Prisma migrations
# (prisma migrate deploy). In production set it to Neon's connection string
# without "-pooler" in the host. Leave unset locally to use DATABASE_URL.
# DIRECT_URL=postgresql://user:password@localhost:5432/crm_db
PORT=4000
# Required — the server refuses to start without a real value here (config.ts).
# Generate one, don't hand-type it: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173

# Used only by `npm run seed` to create/update the admin account — change the password
# before running seed against anything beyond a local dev database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ── Phase 32: WhatsApp (PHASE32_TODO.md §15) ─────────────────────────────────────
# Everything is OFF / dry-run by default; with none of these set nothing is ever sent.
# Real sending needs WHATSAPP_ENABLED=true + WHATSAPP_PROVIDER=meta + the credentials
# below, and outside NODE_ENV=production ALSO WHATSAPP_ALLOW_NON_PRODUCTION_SEND=true
# (only for the deliberate Meta test-number check). Never commit real values.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=dryrun
WHATSAPP_ALLOW_NON_PRODUCTION_SEND=false
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_CONFIRMATION=ps_order_confirmation
WHATSAPP_TEMPLATE_DISPATCHED=ps_order_dispatched
