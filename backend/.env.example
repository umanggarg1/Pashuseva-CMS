# Backend env (copy to .env)
DATABASE_URL=postgresql://user:password@localhost:5432/crm_db
# Optional: direct (non-pooled) connection used only by Prisma migrations
# (prisma migrate deploy). In production set it to Neon's connection string
# without "-pooler" in the host. Leave unset locally to use DATABASE_URL.
# DIRECT_URL=postgresql://user:password@localhost:5432/crm_db
PORT=4000
# Required — the server refuses to start without a real value here (config.ts).
# Generate one, don't hand-type it: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173

# Used only by `npm run seed` to create/update the admin account — change the password
# before running seed against anything beyond a local dev database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
